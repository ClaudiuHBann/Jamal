# Create a bot in https://discord.com/developers/applications and paste its token here.
DISCORD_TOKEN=

# Your test server ID gives you instant slash-command registration.
# Leave blank to register globally (Discord can take time to display updates).
DISCORD_GUILD_ID=

# Use a long random password. Lavalink and the private cipher API share it.
LAVALINK_PASSWORD=

# Optional YouTube sign-in. Follow the YouTube sign-in guide before enabling it.
YOUTUBE_REFRESH_TOKEN=
